{
  "name": "clauseguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/run-browser-suite.mjs",
    "test:browser:p1": "node scripts/test-p1-browser.mjs",
    "test:browser:p0": "node scripts/test-browser.mjs",
    "test:browser:p2": "node scripts/test-p2-browser.mjs",
    "test:risk:model": "node scripts/test-risk-model.mjs",
    "fixture": "node scripts/serve-fixture.mjs",
    "gpu:diagnostics": "node scripts/gpu-diagnostics.mjs",
    "report:evidence": "node scripts/report-evidence.mjs",
    "report:reliability": "node scripts/report-reliability.mjs",
    "report:p1": "node scripts/report-p1.mjs",
    "report:p2": "node scripts/report-p2.mjs",
    "ollama:start": "powershell -NoProfile -File scripts/start-ollama.ps1",
    "postinstall": "wxt prepare",
    "test:browser:p3": "node scripts/test-p3-browser.mjs",
    "test:access:p3": "node scripts/test-p3-access.mjs",
    "report:p3": "node scripts/report-p3.mjs",
    "eval:acquire": "node scripts/collect-p4-real.mjs",
    "eval:reference": "node scripts/prepare-p4-reference.mjs",
    "eval:real": "node scripts/eval-real.mjs",
    "eval:metrics": "node scripts/eval-metrics.mjs",
    "eval:report": "node scripts/eval-report.mjs",
    "test:security:p4": "node scripts/test-p4-security.mjs",
    "test:semantics:p4": "node scripts/test-p4-semantics.mjs",
    "test:reproduce:p3": "node scripts/reproduce-p3-failure.mjs",
    "report:p4": "node scripts/report-p4.mjs",
    "test:regression:p4": "node scripts/run-p4-regression.mjs",
    "eval:p4.1": "node scripts/eval-p4-1.mjs",
    "test:p4.1:targeted": "node scripts/test-p4-1-targeted.mjs",
    "report:p4.1": "node scripts/report-p4-1.mjs",
    "test:llms": "node scripts/test-llms.mjs",
    "mcp:start": "node scripts/mcp-start.mjs",
    "mcp:test": "node scripts/mcp-test.mjs",
    "test:smoke": "node scripts/test-smoke.mjs",
    "demo:record": "node scripts/demo-record.mjs",
    "demo:edit": "node scripts/demo-edit.mjs",
    "demo:verify": "node scripts/demo-verify.mjs",
    "demo:all": "node scripts/demo-all.mjs",
    "delivery:package": "node scripts/package-delivery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@page-agent/core": "^1.12.4",
    "@page-agent/llms": "^1.12.4",
    "@page-agent/page-controller": "^1.12.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "cypress": "^15.7.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
